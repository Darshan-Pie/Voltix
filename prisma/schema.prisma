generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  password              String
  name                  String?
  role                  Role             @default(USER)
  isActive              Boolean          @default(true)
  canAccessAdminCatalog Boolean          @default(false)
  createdAt             DateTime         @default(now())
  catalogItems          ComponentPrice[]
}

model ComponentPrice {
  id              String  @id @default(cuid())
  userId          String  @default("")
  catalogNumber   String?
  description     String
  make            String
  category        String
  listPrice       Float
  discountPercent Float   @default(0)
  netPrice        Float
  entryType       String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, description, make])
  @@unique([userId, catalogNumber])
}
